# --- Firebase client config (safe to expose in the browser bundle) ---
# Build-time values. On Cloudflare set these as Build variables, or put them in
# a local .env file when running `npm run build` yourself.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Admin allowlist: comma-separated Google account emails ---
# Cloudflare runtime secret: `wrangler secret put ADMIN_EMAILS`
ADMIN_EMAILS=support@mindfulwellness.io

# --- Firebase service account (server-side only, never expose) ---
# Used by the Worker to call Firestore over REST and to verify ID tokens.
# Cloudflare runtime secrets:
#   wrangler secret put FIREBASE_PROJECT_ID
#   wrangler secret put FIREBASE_CLIENT_EMAIL
#   wrangler secret put FIREBASE_PRIVATE_KEY
#
# Option A: paste the full service-account JSON on one line, or its base64
# FIREBASE_SERVICE_ACCOUNT=
# Option B: provide the individual fields instead
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Optional ---
# Firestore collection name (default: bookings) -- set in wrangler.toml [vars]
BOOKINGS_COLLECTION=bookings
# Force local dev auth mode (auto-enabled outside production when Firebase is unconfigured)
# ADMIN_DEV_MODE=true
